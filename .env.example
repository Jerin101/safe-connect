# Copy this file to .env (`cp .env.example .env`). .env is ignored by Git: never commit it.
# These are local settings only. The website itself has no build step and does not read this file; the public
# Firebase web config lives in src/js/firebase-config.js on purpose (see SECURITY.md). Do NOT put real secrets
# (service-account keys, passwords, tokens) anywhere in the repo.

# --- Docker (docker-compose.yml) ---
WEB_PORT=8080
TZ=Asia/Dhaka

# --- Tests (Node 20+: `node --env-file=.env tests/routes-test.mjs`) ---
# Where the Chrome page tests open the site (start it with: python -m http.server 8000 -d src)
BASE=http://127.0.0.1:8000/
# Full path to Chrome or Edge if it is not in the usual place (leave empty to use the default list)
CHROME=
# Folder for screenshots (leave empty for none)
SHOTS=

# --- Firebase emulator (npm run test:rules uses a fake project, no real data) ---
FIREBASE_PROJECT=demo-safeconnect
