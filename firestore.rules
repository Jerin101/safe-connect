rules_version = '2';

// SafeConnect security rules (P17). The site has no server code (Firebase Spark),
// so these rules are the only protection. Hiding a button is never enough.
// - Help (999, send location, area numbers) never touches Firestore: it works signed out.
// - Roles: users/{uid}.role is a copy for display; admins/{uid} is added only in the Firebase console.
// - Every admin change is a batched write together with a new audit/{id} entry (checked with getAfter).
// - Anything not listed here (applications, confirmations, volunteers, teams) stays closed until P38.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function incoming() { return request.resource.data; }
    function changed() { return incoming().diff(resource.data).affectedKeys(); }
    function shortText(v, max) { return v is string && v.size() <= max; }
    function bdMobile(v) { return v is string && v.matches('^01[3-9][0-9]{8}$'); }

    // An admin change must carry lastAuditId, and that audit entry must be created
    // in the same batch, by this admin, about this exact document and action.
    function audited(entity, id, action) {
      let auditId = incoming().lastAuditId;
      let path = /databases/$(database)/documents/audit/$(auditId);
      return auditId is string
        && !exists(path)
        && existsAfter(path)
        && getAfter(path).data.actorUid == request.auth.uid
        && getAfter(path).data.entity == entity
        && getAfter(path).data.entityId == id
        && getAfter(path).data.action == action;
    }
    // A role change (issue #65): the audit entry must say the real old and new role.
    function roleAudited() {
      let meta = getAfter(/databases/$(database)/documents/audit/$(incoming().lastAuditId)).data.meta;
      return meta.from == resource.data.get('role', 'user') && meta.to == incoming().role;
    }
    // The other half (issue #65): a new audit entry is allowed only together with the change it is
    // about, in the same batch (that document must point back to this entry).
    function changedWith(entity, id, auditId) {
      let path = /databases/$(database)/documents/$(entity)/$(id);
      return existsAfter(path) && getAfter(path).data.get('lastAuditId', '') == auditId;
    }

    // ---------- people ----------
    match /users/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create: if isMe(uid)
        && incoming().keys().hasOnly(['name', 'email', 'lang', 'createdAt', 'role'])
        && incoming().role == 'user'
        && incoming().get('email', '') == request.auth.token.get('email', '')
        && shortText(incoming().get('name', ''), 60)
        && incoming().get('lang', 'bn') in ['bn', 'en']
        && incoming().createdAt == request.time;
      // The owner may change only name and language, never the role.
      allow update: if (isMe(uid)
          && changed().hasOnly(['name', 'lang'])
          && shortText(incoming().get('name', ''), 60)
          && incoming().get('lang', 'bn') in ['bn', 'en'])
        // An admin may change only the role (user <-> volunteer) of someone else, with an audit entry
        // that names the old and the new role. New admins are added only in the Firebase console.
        || (isAdmin()
          && uid != request.auth.uid
          && !exists(/databases/$(database)/documents/admins/$(uid))
          && changed().hasOnly(['role', 'lastAuditId'])
          && incoming().role in ['user', 'volunteer']
          && incoming().role != resource.data.get('role', 'user')
          && audited('users', uid, 'ROLE_CHANGED')
          && roleAudited());
      allow delete: if isMe(uid);
    }

    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Family numbers: only if the person turns on sync. Owner only.
    match /family/{uid}/people/{personId} {
      allow read, delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && incoming().keys().hasOnly(['name', 'relation', 'phone'])
        && shortText(incoming().name, 40) && incoming().name.size() > 0
        && shortText(incoming().get('relation', ''), 20)
        && bdMobile(incoming().phone);
    }

    // Saved areas. Owner only. No home addresses: only district, upazila and area names.
    match /places/{uid}/saved/{placeId} {
      allow read, delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && incoming().keys().hasOnly(['district', 'upazila', 'area'])
        && incoming().district in ['noakhali', 'coxsbazar']
        && shortText(incoming().upazila, 60)
        && shortText(incoming().get('area', ''), 80);
    }

    // ---------- wrong-number reports ----------
    // Limits (security audit M1, issue #117): only a verified email (Google sign-in is verified), at most
    // 10 per rolling 24 hours and one per minute. Each new report is written in one batch with
    // reportLimits/{uid}, and each side checks the other, so the limit cannot be skipped.
    function verified() { return request.auth.token.get('email_verified', false) == true; }
    function limitsAfter() { return getAfter(/databases/$(database)/documents/reportLimits/$(request.auth.uid)).data; }

    match /reportLimits/{uid} {
      allow read: if isMe(uid);
      allow create, update: if isMe(uid) && verified()
        && incoming().keys().hasOnly(['windowStart', 'count', 'last', 'lastReport'])
        && incoming().last == request.time
        && incoming().lastReport is string
        // the report it points to is new, belongs to this person and is created in this same batch
        && !exists(/databases/$(database)/documents/reports/$(incoming().lastReport))
        && existsAfter(/databases/$(database)/documents/reports/$(incoming().lastReport))
        && getAfter(/databases/$(database)/documents/reports/$(incoming().lastReport)).data.uid == uid
        && (resource == null
          ? (incoming().windowStart == request.time && incoming().count == 1)
          : (request.time >= resource.data.last + duration.value(60, 's')
            && (request.time < resource.data.windowStart + duration.value(24, 'h')
              ? (incoming().windowStart == resource.data.windowStart && incoming().count == resource.data.count + 1 && incoming().count <= 10)
              : (incoming().windowStart == request.time && incoming().count == 1))));
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if signedIn() && verified()
        && limitsAfter().lastReport == reportId && limitsAfter().last == request.time
        && incoming().keys().hasOnly(['uid', 'recordId', 'district', 'area', 'problem', 'note', 'status', 'createdAt', 'updatedAt'])
        && incoming().uid == request.auth.uid
        && incoming().status == 'open'
        && shortText(incoming().recordId, 120)
        && incoming().district in ['noakhali', 'coxsbazar']
        && shortText(incoming().get('area', ''), 80)
        && incoming().problem in ['off', 'other_person', 'changed', 'other']
        && shortText(incoming().get('note', ''), 500)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      // Only an admin moves the status, always with an audit entry.
      allow update: if isAdmin()
        && changed().hasOnly(['status', 'updatedAt', 'lastAuditId'])
        && incoming().status in ['open', 'review', 'fixed', 'same']
        && incoming().updatedAt == request.time
        && audited('reports', reportId, 'REPORT_STATUS_CHANGED');
      allow delete: if false;
    }

    // ---------- audit log: append-only ----------
    match /audit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && incoming().keys().hasOnly(['actorUid', 'action', 'entity', 'entityId', 'at', 'meta'])
        && incoming().actorUid == request.auth.uid
        && ((incoming().action == 'REPORT_STATUS_CHANGED' && incoming().entity == 'reports')
          || (incoming().action == 'ROLE_CHANGED' && incoming().entity == 'users'))
        && incoming().entityId is string
        && incoming().entityId.matches('^[A-Za-z0-9_-]{1,128}$')
        && incoming().at == request.time
        && (!('meta' in incoming()) || (incoming().meta is map
          && incoming().meta.keys().hasOnly(['from', 'to'])
          && shortText(incoming().meta.get('from', ''), 20)
          && shortText(incoming().meta.get('to', ''), 20)))
        && changedWith(incoming().entity, incoming().entityId, auditId);
      allow update, delete: if false;
    }

    // Everything else is closed (volunteer collections open in P38).
  }
}
