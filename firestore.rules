rules_version = '2';

// SafeConnect security rules (P17). The site has no server code (Firebase Spark),
// so these rules are the only protection. Hiding a button is never enough.
// - Help (999, send location, area numbers) never touches Firestore: it works signed out.
// - Roles: users/{uid}.role is a copy for display; admins/{uid} is added only in the Firebase console.
// - Every admin change is a batched write together with a new audit/{id} entry (checked with getAfter).
// - Anything not listed here (applications, confirmations, volunteers, teams) stays closed until P38.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function incoming() { return request.resource.data; }
    function changed() { return incoming().diff(resource.data).affectedKeys(); }
    function shortText(v, max) { return v is string && v.size() <= max; }
    function bdMobile(v) { return v is string && v.matches('^01[3-9][0-9]{8}$'); }
    // A Bangladeshi mobile number anywhere in a text: English or Bangla digits; spaces, dashes, dots, slashes or
    // brackets between digits; with or without +88 / 88. Not part of a longer digit string (years, account numbers).
    // Same pattern as js/reports.js PHONE_IN_TEXT (issue #123).
    function noPhone(v) { return !v.matches('(?s)(.*[^0-9০-৯])?(\\+?[8৮][8৮][- \\x{00A0}./()\\x{2013}]*)?[0০][- \\x{00A0}./()\\x{2013}]*[1১][- \\x{00A0}./()\\x{2013}]*[3-9৩-৯]([- \\x{00A0}./()\\x{2013}]*[0-9০-৯]){8}([^0-9০-৯].*)?'); }

    // An admin change must carry lastAuditId, and that audit entry must be created
    // in the same batch, by this admin, about this exact document and action.
    function audited(entity, id, action) {
      let auditId = incoming().lastAuditId;
      let path = /databases/$(database)/documents/audit/$(auditId);
      return auditId is string
        && !exists(path)
        && existsAfter(path)
        && getAfter(path).data.actorUid == request.auth.uid
        && getAfter(path).data.entity == entity
        && getAfter(path).data.entityId == id
        && getAfter(path).data.action == action;
    }
    // A role change (issue #65): the audit entry must say the real old and new role.
    function roleAudited() {
      let meta = getAfter(/databases/$(database)/documents/audit/$(incoming().lastAuditId)).data.meta;
      return meta.from == resource.data.get('role', 'user') && meta.to == incoming().role;
    }
    // The other half (issue #65): a new audit entry is allowed only together with the change it is
    // about, in the same batch (that document must point back to this entry).
    function changedWith(entity, id, auditId) {
      let path = /databases/$(database)/documents/$(entity)/$(id);
      return existsAfter(path) && getAfter(path).data.get('lastAuditId', '') == auditId;
    }

    // ---------- people ----------
    match /users/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create: if isMe(uid)
        && incoming().keys().hasOnly(['name', 'email', 'lang', 'createdAt', 'role'])
        && incoming().role == 'user'
        && incoming().get('email', '') == request.auth.token.get('email', '')
        && shortText(incoming().get('name', ''), 60)
        && incoming().get('lang', 'bn') in ['bn', 'en']
        && incoming().createdAt == request.time;
      // The owner may change only name and language, never the role.
      allow update: if (isMe(uid)
          && changed().hasOnly(['name', 'lang'])
          && shortText(incoming().get('name', ''), 60)
          && incoming().get('lang', 'bn') in ['bn', 'en'])
        // An admin may change only the role (user <-> volunteer) of someone else, with an audit entry
        // that names the old and the new role. New admins are added only in the Firebase console.
        || (isAdmin()
          && uid != request.auth.uid
          && !exists(/databases/$(database)/documents/admins/$(uid))
          && changed().hasOnly(['role', 'lastAuditId'])
          && incoming().role in ['user', 'volunteer']
          && incoming().role != resource.data.get('role', 'user')
          && audited('users', uid, 'ROLE_CHANGED')
          && roleAudited());
      allow delete: if isMe(uid);
    }

    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Family numbers: only if the person turns on sync. Owner only.
    match /family/{uid}/people/{personId} {
      allow read, delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && incoming().keys().hasOnly(['name', 'relation', 'phone'])
        && shortText(incoming().name, 40) && incoming().name.size() > 0
        && shortText(incoming().get('relation', ''), 20)
        && bdMobile(incoming().phone);
    }

    // Saved areas. Owner only. No home addresses: only district, upazila and area names.
    match /places/{uid}/saved/{placeId} {
      allow read, delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && incoming().keys().hasOnly(['district', 'upazila', 'area'])
        && incoming().district in ['noakhali', 'coxsbazar']
        && shortText(incoming().upazila, 60)
        && shortText(incoming().get('area', ''), 80);
    }

    // ---------- wrong-number reports ----------
    // Limits (security audit M1, issue #117): a report needs a verified email (Google sign-in is verified), and
    // at most 10 per person per day (UTC day number) with 60 s between two. The report and limits/{uid} are written
    // in one batch and each checks the other (getAfter), so a report without a correct counter update fails, and the
    // counter cannot be lowered, reset or moved to another day. Admins are exempt.
    function verified() { return request.auth.token.get('email_verified', false) == true; }
    function today() { return int(request.time.toMillis() / 86400000); }
    function limitsAfter() { return getAfter(/databases/$(database)/documents/limits/$(request.auth.uid)).data; }

    match /limits/{uid} {
      allow read: if isMe(uid);
      allow create, update: if isMe(uid) && verified()
        && incoming().keys().hasOnly(['day', 'count', 'lastAt', 'lastReport'])
        && incoming().day == today()
        && incoming().lastAt == request.time
        && incoming().count is int && incoming().count <= 10
        && incoming().lastReport is string
        // it points to a new report of this person, created in this same batch
        && !exists(/databases/$(database)/documents/reports/$(incoming().lastReport))
        && existsAfter(/databases/$(database)/documents/reports/$(incoming().lastReport))
        && getAfter(/databases/$(database)/documents/reports/$(incoming().lastReport)).data.uid == uid
        && (resource == null
          ? incoming().count == 1
          : (request.time >= resource.data.lastAt + duration.value(60, 's')
            && incoming().count == (resource.data.day == today() ? resource.data.count + 1 : 1)));
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if signedIn()
        && (isAdmin() || (verified() && limitsAfter().lastReport == reportId && limitsAfter().lastAt == request.time))
        && incoming().keys().hasOnly(['uid', 'recordId', 'district', 'area', 'problem', 'note', 'status', 'createdAt', 'updatedAt', 'place', 'upazila', 'union'])
        && incoming().uid == request.auth.uid
        && incoming().status == 'open'
        && shortText(incoming().recordId, 120)
        && incoming().district is string && incoming().district.matches('^[a-z]{3,30}$')   // a number or a place in any district (FR15)
        && shortText(incoming().get('area', ''), 80)
        && incoming().problem in ['off', 'other_person', 'changed', 'other', 'missing_place']
        // "জায়গাটা যোগ করতে বলুন" (#159): a place name the search did not know, with its upazila (and union if known).
        // Same limits as every report; no record; never a phone number. Other kinds carry none of these fields.
        && (incoming().problem == 'missing_place'
          ? (incoming().recordId == 'missing-place'
            && incoming().place is string && incoming().place.size() >= 2 && shortText(incoming().place, 80) && noPhone(incoming().place)
            && incoming().upazila is string && incoming().upazila.size() >= 2 && shortText(incoming().upazila, 60) && noPhone(incoming().upazila)
            && shortText(incoming().get('union', ''), 80) && noPhone(incoming().get('union', '')))
          : !('place' in incoming()) && !('upazila' in incoming()) && !('union' in incoming()))
        && shortText(incoming().get('note', ''), 500)
        && noPhone(incoming().get('note', ''))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      // Only an admin moves the status, always with an audit entry.
      allow update: if isAdmin()
        && changed().hasOnly(['status', 'updatedAt', 'lastAuditId'])
        && incoming().status in ['open', 'review', 'fixed', 'same']
        && incoming().updatedAt == request.time
        && audited('reports', reportId, 'REPORT_STATUS_CHANGED');
      allow delete: if false;
    }

    // ---------- audit log: append-only ----------
    match /audit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && incoming().keys().hasOnly(['actorUid', 'action', 'entity', 'entityId', 'at', 'meta'])
        && incoming().actorUid == request.auth.uid
        && ((incoming().action == 'REPORT_STATUS_CHANGED' && incoming().entity == 'reports')
          || (incoming().action == 'ROLE_CHANGED' && incoming().entity == 'users')
          || (incoming().action == 'PROVIDER_APPROVED' && incoming().entity == 'providers')
          || (incoming().action == 'PROVIDER_REJECTED' && incoming().entity == 'providers')
          || (incoming().action == 'RATES_CHANGED' && incoming().entity == 'fare_rates'))
        && incoming().entityId is string
        && incoming().entityId.matches('^[A-Za-z0-9_-]{1,128}$')
        && incoming().at == request.time
        && (!('meta' in incoming()) || (incoming().meta is map
          && incoming().meta.keys().hasOnly(['from', 'to'])
          && shortText(incoming().meta.get('from', ''), 20)
          && shortText(incoming().meta.get('to', ''), 20)))
        && changedWith(incoming().entity, incoming().entityId, auditId);
      allow update, delete: if false;
    }

    // Text written by people: a length range and never a phone number (place status, ride labels and lists).
    function placeText(v, min, max) { return v is string && v.size() >= min && v.size() <= max && noPhone(v); }

    // ---------- place status: "এখন খোলা? তেল আছে?" (impact plan, feature 5) ----------
    // placeStatus/{placeId} is public and names nobody: the latest answer, how many people gave it, and when.
    // Each person's own answer is in placeStatus/{placeId}/by/{uid} (only they read it), at most once in 30 minutes
    // per place. The count grows only when the same answer comes again within 6 hours; a new answer starts at 1.
    // Both writes are one batch and check each other.
    function placeValues() { return ['open', 'closed', 'fuel_yes', 'fuel_no', 'open_night', 'shelter_open']; }
    match /placeStatus/{placeId} {
      allow read: if true;
      allow create, update: if signedIn() && verified()
        && placeId.matches('^[a-z0-9-]{3,80}$')
        && incoming().keys().hasOnly(['status', 'n', 'at', 'prev'])
        && incoming().status in placeValues()
        && incoming().at == request.time
        // "prev" (conflict flag): only when this answer differs from the one before it and that one is within 6 hours (request.time <= its time + 6 h);
        // it must be exactly that earlier answer. Without a disagreement, "prev" is not allowed.
        && (!('prev' in incoming()) || (resource != null
            && resource.data.get('status', '') != incoming().status
            && request.time <= resource.data.at + duration.value(6, 'h')
            && incoming().prev == resource.data.get('status', '')))
        && getAfter(/databases/$(database)/documents/placeStatus/$(placeId)/by/$(request.auth.uid)).data.at == request.time
        && getAfter(/databases/$(database)/documents/placeStatus/$(placeId)/by/$(request.auth.uid)).data.status == incoming().status
        && (resource == null || resource.data.get('status', '') != incoming().status || request.time > resource.data.at + duration.value(6, 'h')
          ? incoming().n == 1
          : incoming().n == resource.data.n + 1);
      allow delete: if false;

      // each person's own answer (the "uid" of the ER diagram is this document's id); only they read it
      match /by/{uid} {
        allow read: if isMe(uid);
        allow create, update: if isMe(uid) && verified()
          && incoming().keys().hasOnly(['status', 'at'])
          && incoming().status in placeValues()
          && incoming().at == request.time
          && (resource == null || request.time > resource.data.at + duration.value(30, 'm'))
          && getAfter(/databases/$(database)/documents/placeStatus/$(placeId)).data.at == request.time;
        allow delete: if false;
      }
    }

    // ---------- "ডাকুন": service engine (vehicle, technician, nearby helper) with live map and bill ----------
    // providers/{uid}: someone who drives, repairs or helps. They apply; only an admin approves (with an audit entry).
    // rates/{type}: the fare rates, public, set by an admin (audit). rides/{id}: one request from asking to paying;
    // each step can be taken only by the right person and only in order (requested → accepted → arrived → on_trip →
    // completed → paid, or cancelled). rides/{id}/live/{rider|provider}: the live position, only for the two people
    // of an active ride; it is deleted when the ride ends. online/{uid}: approved providers who are working now, with
    // a rough position (about 100 m) for "nearby" counts. rideLimits/{uid}: at most 10 requests a day, 60 s apart.
    function ridePath(id) { return /databases/$(database)/documents/rides/$(id); }
    function provPath(uid) { return /databases/$(database)/documents/providers/$(uid); }
    // fare_rates/{district}__{serviceType}: a district's own rate, else the nationwide one (district "default")
    function rateDoc(d, t) { return /databases/$(database)/documents/fare_rates/$(d + '__' + t); }
    function hasRate(d, t) { return exists(rateDoc(d, t)) || exists(rateDoc('default', t)); }
    function rateFor(d, t) { return exists(rateDoc(d, t)) ? get(rateDoc(d, t)).data : get(rateDoc('default', t)).data; }
    function myProv() { return get(provPath(request.auth.uid)).data; }
    function rideTypes() { return ['ambulance', 'cng', 'bike', 'technician', 'help', 'errand', 'towing', 'pickup', 'easybike', 'rickshaw', 'van']; }
    function inBd(lat, lon) { return lat is number && lon is number && lat >= 20.5 && lat <= 26.7 && lon >= 88.0 && lon <= 92.7; }
    // Stored points are rounded to 3 decimals (about 100 m, CLAUDE.md rule 5): the exact spot is only in the live
    // documents, which exist during the ride and are deleted at its end.
    function round3(v) { return math.abs(v * 1000 - math.round(v * 1000)) < 0.001; }
    function placeMap(m) { return m is map && m.keys().hasOnly(['lat', 'lon', 'label']) && inBd(m.lat, m.lon) && round3(m.lat) && round3(m.lon) && placeText(m.label, 2, 80); }
    function isProviderFor(r) {
      return signedIn() && exists(provPath(request.auth.uid)) && myProv().approved == true
        && myProv().type == r.type && myProv().district == r.district;
    }
    function rideLimitsAfter() { return getAfter(/databases/$(database)/documents/rideLimits/$(request.auth.uid)).data; }
    function moved(from, to) { return resource.data.status == from && incoming().status == to; }
    function now(f) { return incoming().get(f, null) == request.time; }
    // The fare the rules accept: within 5 taka of max(minimum, base + perKm × km + perMin × (wait − 3)).
    function fareOk(d, t, distM, waitMin, f) {
      let rt = rateFor(d, t);
      let raw = rt.baseFare + rt.perKmRate * (distM / 1000.0) + rt.waitingRate * (waitMin > 3 ? waitMin - 3 : 0);
      let want = raw > rt.minFare ? raw : rt.minFare;
      return f is int && f >= 0 && (want <= 0 ? f == 0 : (f >= want && f <= want + 5));
    }

    match /providers/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create: if isMe(uid) && verified()
        && incoming().keys().hasOnly(['name', 'type', 'vehicle', 'district', 'approved', 'createdAt', 'updatedAt'])
        && incoming().type in rideTypes()
        && incoming().district is string && incoming().district.matches('^[a-z]{3,30}$')
        && placeText(incoming().name, 2, 60) && placeText(incoming().vehicle, 2, 40)
        && incoming().approved == false
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if (isMe(uid) && resource.data.approved == false
          && changed().hasOnly(['name', 'vehicle', 'updatedAt'])
          && placeText(incoming().name, 2, 60) && placeText(incoming().vehicle, 2, 40) && now('updatedAt'))
        // approve: approved true (and not rejected); reject: approved false and rejected true (FR16, use case 14 "3.1")
        || (isAdmin() && uid != request.auth.uid
          && changed().hasOnly(['approved', 'rejected', 'updatedAt', 'lastAuditId']) && now('updatedAt')
          && ((incoming().approved == true && incoming().get('rejected', false) == false && resource.data.approved == false
              && audited('providers', uid, 'PROVIDER_APPROVED'))
            || (incoming().approved == false && incoming().get('rejected', false) == true && resource.data.get('rejected', false) == false
              && audited('providers', uid, 'PROVIDER_REJECTED'))
            || (incoming().approved == false && incoming().get('rejected', false) == false && resource.data.approved == true
              && audited('providers', uid, 'PROVIDER_APPROVED'))));
      allow delete: if isMe(uid) && resource.data.approved == false;
    }

    match /fare_rates/{rateId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && incoming().keys().hasOnly(['district', 'serviceType', 'baseFare', 'perKmRate', 'waitingRate', 'minFare', 'updatedAt', 'lastAuditId'])
        && incoming().serviceType in rideTypes()
        && incoming().district is string && (incoming().district == 'default' || incoming().district.matches('^[a-z]{3,30}$'))
        && rateId == incoming().district + '__' + incoming().serviceType
        && incoming().baseFare is int && incoming().baseFare >= 0 && incoming().baseFare <= 10000
        && incoming().perKmRate is int && incoming().perKmRate >= 0 && incoming().perKmRate <= 1000
        && incoming().waitingRate is int && incoming().waitingRate >= 0 && incoming().waitingRate <= 100
        && incoming().minFare is int && incoming().minFare >= 0 && incoming().minFare <= 20000
        && (incoming().serviceType != 'help' || (incoming().baseFare == 0 && incoming().perKmRate == 0 && incoming().waitingRate == 0 && incoming().minFare == 0))
        && now('updatedAt')
        && audited('fare_rates', rateId, 'RATES_CHANGED');
      allow delete: if false;
    }

    match /online/{uid} {
      allow read: if signedIn() && verified();
      allow create, update: if isMe(uid) && exists(provPath(uid)) && myProv().approved == true
        // no position at all: riders only see how many providers of a type work in the district
        && incoming().keys().hasOnly(['type', 'district', 'at'])
        && incoming().type == myProv().type && incoming().district == myProv().district
        && incoming().at == request.time;
      allow delete: if isMe(uid);
    }

    match /rideLimits/{uid} {
      allow read: if isMe(uid);
      allow create, update: if isMe(uid) && verified()
        && incoming().keys().hasOnly(['day', 'count', 'lastAt', 'lastRide'])
        && incoming().day == today() && incoming().lastAt == request.time
        && incoming().count is int && incoming().count <= 10
        && incoming().lastRide is string
        && !exists(ridePath(incoming().lastRide)) && existsAfter(ridePath(incoming().lastRide))
        && getAfter(ridePath(incoming().lastRide)).data.riderUid == uid
        && (resource == null
          ? incoming().count == 1
          : (request.time >= resource.data.lastAt + duration.value(60, 's')
            && incoming().count == (resource.data.day == today() ? resource.data.count + 1 : 1)));
      allow delete: if false;
    }

    match /rides/{rideId} {
      allow read: if signedIn() && (resource.data.riderUid == request.auth.uid
        || resource.data.get('providerUid', null) == request.auth.uid
        || isAdmin()
        || (resource.data.status == 'requested' && isProviderFor(resource.data)));
      allow create: if signedIn() && verified()
        && rideLimitsAfter().lastRide == rideId && rideLimitsAfter().lastAt == request.time
        && incoming().keys().hasOnly(['riderUid', 'type', 'district', 'pickup', 'drop', 'estM', 'estFare', 'items', 'maxItems', 'status', 'createdAt', 'updatedAt'])
        // "আনিয়ে দিন": pickup = the shop, drop = the rider; the list of things and the most the rider will pay for them
        && (incoming().type == 'errand'
          ? ('drop' in incoming() && placeText(incoming().get('items', ''), 2, 300)
            && incoming().get('maxItems', 0) is int && incoming().get('maxItems', 0) >= 1 && incoming().get('maxItems', 0) <= 20000)
          // "তৈরি অর্ডার তুলে আনুন": already paid at the shop, so a list to collect but no money limit
          : incoming().type == 'pickup'
            ? ('drop' in incoming() && placeText(incoming().get('items', ''), 2, 300) && !('maxItems' in incoming()))
            : (!('items' in incoming()) && !('maxItems' in incoming())))
        && incoming().riderUid == request.auth.uid
        && incoming().type in rideTypes() && incoming().district is string && hasRate(incoming().district, incoming().type)
        && incoming().district is string && incoming().district.matches('^[a-z]{3,30}$')
        && placeMap(incoming().pickup)
        && (!('drop' in incoming()) || placeMap(incoming().drop))
        && incoming().estM is int && incoming().estM >= 0 && incoming().estM <= 300000
        && incoming().estFare is int && incoming().estFare >= 0 && incoming().estFare <= 100000
        && incoming().status == 'requested'
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if signedIn() && now('updatedAt') && (
        // accept: an approved provider of this type and district, not the rider; only while nobody has it
        (moved('requested', 'accepted') && isProviderFor(resource.data) && resource.data.riderUid != request.auth.uid
          && changed().hasOnly(['status', 'providerUid', 'providerName', 'vehicle', 'acceptedAt', 'updatedAt'])
          && incoming().providerUid == request.auth.uid && incoming().providerName == myProv().name
          && incoming().vehicle == myProv().vehicle && now('acceptedAt'))
        // the provider's steps
        || (resource.data.get('providerUid', null) == request.auth.uid && (
          (moved('accepted', 'arrived') && changed().hasOnly(['status', 'arrivedAt', 'updatedAt']) && now('arrivedAt'))
          || (moved('arrived', 'on_trip') && changed().hasOnly(['status', 'startedAt', 'updatedAt']) && now('startedAt'))
          || (moved('on_trip', 'completed')
            && changed().hasOnly(['status', 'endedAt', 'distM', 'waitMin', 'fare', 'itemsCost', 'payStatus', 'updatedAt']) && now('endedAt')
            // errand: the shop's receipt amount, never more than the rider allowed; other types have none
            && (resource.data.type == 'errand'
              ? (incoming().get('itemsCost', -1) is int && incoming().get('itemsCost', -1) >= 0 && incoming().get('itemsCost', -1) <= resource.data.maxItems)
              : !('itemsCost' in incoming()))
            && incoming().distM is int && incoming().distM >= 0 && incoming().distM <= resource.data.estM * 3 + 5000
            && incoming().waitMin is int && incoming().waitMin >= 0
            && incoming().waitMin <= (resource.data.startedAt.toMillis() - resource.data.arrivedAt.toMillis()) / 60000 + 1
            && incoming().payStatus == 'pending'
            && fareOk(resource.data.district, resource.data.type, incoming().distM, incoming().waitMin, incoming().fare))
          || (moved('completed', 'paid') && changed().hasOnly(['status', 'payStatus', 'paidAt', 'updatedAt'])
            && incoming().payStatus == 'paid' && now('paidAt'))
          || (resource.data.status in ['accepted', 'arrived'] && incoming().status == 'cancelled'
            && changed().hasOnly(['status', 'cancelledBy', 'cancelFee', 'updatedAt'])
            && incoming().cancelledBy == 'provider' && incoming().cancelFee == 0)))
        // the rider's steps
        || (resource.data.riderUid == request.auth.uid && (
          (resource.data.status in ['requested', 'accepted', 'arrived'] && incoming().status == 'cancelled'
            && changed().hasOnly(['status', 'cancelledBy', 'cancelFee', 'updatedAt']) && incoming().cancelledBy == 'rider'
            && incoming().cancelFee == (resource.data.status == 'arrived' ? math.ceil(rateFor(resource.data.district, resource.data.type).baseFare / 10.0) * 5 : 0))
          || (resource.data.status in ['completed', 'paid'] && !('billOk' in resource.data)
            && changed().hasOnly(['billOk', 'updatedAt']) && incoming().billOk is bool)
          // a ride with no answer: the rider may close it after 3 hours (before the trip) or 12 hours (on the trip or
          // waiting for "paid"), so nobody stays stuck on it; no fee
          || (resource.data.status in ['accepted', 'arrived', 'on_trip', 'completed']
            && request.time > resource.data.updatedAt + duration.value(resource.data.status in ['accepted', 'arrived'] ? 3 : 12, 'h')
            && incoming().status == 'cancelled' && changed().hasOnly(['status', 'cancelledBy', 'cancelFee', 'updatedAt'])
            && incoming().cancelledBy == 'stale' && incoming().cancelFee == 0)
          || (resource.data.status == 'paid' && !('rating' in resource.data)
            && changed().hasOnly(['rating', 'updatedAt']) && incoming().rating is int && incoming().rating >= 1 && incoming().rating <= 5)))
      );
      allow delete: if false;

      match /live/{who} {
        allow read: if signedIn() && (get(ridePath(rideId)).data.riderUid == request.auth.uid
          || get(ridePath(rideId)).data.get('providerUid', null) == request.auth.uid);
        allow create, update: if signedIn() && who in ['rider', 'provider']
          && get(ridePath(rideId)).data.status in ['accepted', 'arrived', 'on_trip']
          && ((who == 'rider' && get(ridePath(rideId)).data.riderUid == request.auth.uid)
            || (who == 'provider' && get(ridePath(rideId)).data.get('providerUid', null) == request.auth.uid))
          && incoming().keys().hasOnly(['lat', 'lon', 'at'])
          && inBd(incoming().lat, incoming().lon) && incoming().at == request.time;
        allow delete: if signedIn() && !(get(ridePath(rideId)).data.status in ['accepted', 'arrived', 'on_trip'])
          && (get(ridePath(rideId)).data.riderUid == request.auth.uid
            || get(ridePath(rideId)).data.get('providerUid', null) == request.auth.uid);
      }
    }

    // ---------- live location sharing and Safe Commute (FR09–FR11) ----------
    // live_shares/{shareId}: started by a verified user for at most 8 hours; the id is long and random, so only someone
    // who has the link can read it (get by id, no sign-in), and nobody can list them. Only the owner writes and deletes;
    // updates at most every 4 s. Safe Commute adds the vehicle (number plate, type) and the destination. An expired share
    // can no longer be read; an admin may list and delete expired ones only (cleanup), never an active one.
    // shareLimits/{uid}: at most 20 shares a day, 60 s apart, written in the same batch as the share.
    function shareLimitsAfter() { return getAfter(/databases/$(database)/documents/shareLimits/$(request.auth.uid)).data; }
    function optNum(m, k, lo, hi) { return m.get(k, null) == null || (m.get(k, null) is number && m.get(k, null) >= lo && m.get(k, null) <= hi); }
    function shareOk(m) {
      return inBd(m.lat, m.lon)
        && optNum(m, 'speed', 0, 100) && optNum(m, 'heading', 0, 360)
        && (m.get('battery', null) == null || (m.get('battery', null) is int && m.get('battery', null) >= 0 && m.get('battery', null) <= 100))
        && (!('vehicleNo' in m) || placeText(m.vehicleNo, 2, 30))
        && (!('vehicleType' in m) || m.vehicleType in ['rickshaw', 'easybike', 'cng', 'bus', 'other'])
        && (!('destination' in m) || placeText(m.destination, 2, 60));
    }
    match /live_shares/{shareId} {
      allow get: if resource.data.expiresAt > request.time;
      allow list: if isAdmin() && resource.data.expiresAt < request.time;
      allow create: if signedIn() && verified() && shareId.matches('^[A-Za-z0-9]{24,40}$')
        && shareLimitsAfter().lastShare == shareId && shareLimitsAfter().lastAt == request.time
        && incoming().keys().hasOnly(['uid', 'lat', 'lon', 'speed', 'heading', 'battery', 'vehicleNo', 'vehicleType', 'destination', 'status', 'startedAt', 'updatedAt', 'expiresAt'])
        && incoming().uid == request.auth.uid && incoming().status == 'active'
        && incoming().startedAt == request.time && incoming().updatedAt == request.time
        && incoming().expiresAt is timestamp && incoming().expiresAt > request.time
        && incoming().expiresAt <= request.time + duration.value(482, 'm')
        && shareOk(incoming());
      allow update: if signedIn() && resource.data.uid == request.auth.uid && resource.data.expiresAt > request.time
        && changed().hasOnly(['lat', 'lon', 'speed', 'heading', 'battery', 'vehicleNo', 'vehicleType', 'destination', 'updatedAt'])
        && incoming().updatedAt == request.time
        && request.time >= resource.data.updatedAt + duration.value(4, 's')
        && shareOk(incoming());
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || (isAdmin() && resource.data.expiresAt < request.time));
    }
    match /shareLimits/{uid} {
      allow read: if isMe(uid);
      allow create, update: if isMe(uid) && verified()
        && incoming().keys().hasOnly(['day', 'count', 'lastAt', 'lastShare'])
        && incoming().day == today() && incoming().lastAt == request.time
        && incoming().count is int && incoming().count <= 20
        && incoming().lastShare is string
        && !exists(/databases/$(database)/documents/live_shares/$(incoming().lastShare))
        && existsAfter(/databases/$(database)/documents/live_shares/$(incoming().lastShare))
        && getAfter(/databases/$(database)/documents/live_shares/$(incoming().lastShare)).data.uid == uid
        && (resource == null
          ? incoming().count == 1
          : (request.time >= resource.data.lastAt + duration.value(60, 's')
            && incoming().count == (resource.data.day == today() ? resource.data.count + 1 : 1)));
      allow delete: if false;
    }

    // Everything else is closed (volunteer collections open in P38).
  }
}
