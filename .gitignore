# raw working files from the data collectors (large, re-creatable)
*_raw.json

# kits and downloads belong in E:\Projects\SafeConnect-Files\kits, never in the repo
*.zip

# Python
__pycache__/
*.pyc

# editors / OS
.vscode/
.DS_Store
Thumbs.db

# secrets – never commit keys
.env
.env.*
*serviceAccount*.json
*-firebase-adminsdk-*.json
*.pem
*.key
# public CA certificate the data tools need (not a secret)
!tools/certs/*.pem
firebase-debug.log

# personal Claude Code settings (shared agents in .claude/agents/ stay committed)
.claude/settings.local.json

# Firebase / Node (P17)
node_modules/
firestore-debug.log
ui-debug.log
.firebase/
